---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSitePageFull } from '../lib/notion';
import { SITE_NAME } from '../lib/site';

const page = await getSitePageFull('privacy');
const title = page?.meta.title || '개인정보처리방침';
const description = page?.meta.seoDescription || `${SITE_NAME}의 개인정보처리방침입니다.`;
const body = page?.body || '';
const useNotion = Boolean(body);
---

{
  useNotion ? (
    <BaseLayout title={page!.meta.seoTitle || title} description={description}>
      <section class="post-detail">
        <h1 class="post-detail__title">{title}</h1>
        {page!.meta.excerpt && (
          <p class="post-detail__excerpt">{page!.meta.excerpt}</p>
        )}
        <div class="post-detail__body" set:html={body} />
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout
      title="개인정보처리방침"
      description={`${SITE_NAME}의 개인정보처리방침입니다.`}
    >
      <section class="post-detail">
        <h1 class="post-detail__title">개인정보처리방침</h1>
        <p class="post-detail__excerpt">
          본 사이트는 방문자의 개인정보를 안전하게 보호하기 위해 관련 법령을 준수합니다.
        </p>
        <div class="post-detail__body">
          <h2>수집하는 정보</h2>
          <p>본 사이트는 기본적으로 별도의 회원가입 없이 콘텐츠를 열람하실 수 있습니다. 문의 시 자발적으로 제공하신 정보(이메일 이름, 본문 내용)만 수집합니다.</p>
          <h2>수집 목적</h2>
          <p>문의 응대 및 소통을 위해서만 사용됩니다.</p>
          <h2>보유 기간</h2>
          <p>문의 완료 후 6개월 이내 파기합니다.</p>
          <h2>문의</h2>
          <p>개인정보 관련 문의는 이메일로 연락 주세요.</p>
        </div>
      </section>
    </BaseLayout>
  )
}
