---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSitePageFull } from '../lib/notion';

const page = await getSitePageFull('contact');
const title = page?.meta.title || '문의';
const description = page?.meta.seoDescription || page?.meta.excerpt || '책먹는4차원화가 수업 상담 및 문의 안내 페이지입니다.';
const body = page?.body || '';
const useNotion = Boolean(body);
---

{
  useNotion ? (
    <BaseLayout title={page!.meta.seoTitle || title} description={description}>
      <section class="post-detail">
        <span class="hero__pill">Contact</span>
        <h1 class="post-detail__title">{title}</h1>
        {page!.meta.excerpt && <p class="post-detail__excerpt">{page!.meta.excerpt}</p>}
        <div class="post-detail__body" set:html={body} />
        <div class="cta">
          <h3>프로그램을 먼저 살펴보실래요?</h3>
          <p>수업 성격을 확인한 뒤 상담을 신청하시면 더 빠르게 안내받으실 수 있습니다.</p>
          <a href="/services" class="btn">Programs 보기</a>
        </div>
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout title="문의" description="책먹는4차원화가 수업 상담 및 문의 안내 페이지입니다.">
      <section class="post-detail">
        <span class="hero__pill">Contact</span>
        <h1 class="post-detail__title">수업 문의하기</h1>
        <p class="post-detail__excerpt">
          프로그램 추천, 반 편성, 상담 예약, 출판 프로젝트 문의까지 편하게 남겨 주세요.
        </p>
        <div class="post-detail__body">
          <h2>상담 및 연락처</h2>
          <p><strong>광교본원</strong> : 경기도 수원시 영통구 대학로 101, 201호 | 031-216-2322</p>
          <p><strong>망포분원</strong> : 경기도 수원시 영통구 망포로 142, 202호 | 070-7818-2322</p>
          <p><strong>이메일</strong> : <a href="mailto:book4painter@naver.com">book4painter@naver.com</a></p>
          <p><strong>상담신청</strong> : <a href="https://book4painter.notion.site/200d1fa59b798035a614f3ab95d779e3?pvs=105" target="_blank" rel="noreferrer">온라인 상담 폼 바로가기</a></p>
          <h2>문의 시 함께 알려주시면 좋아요</h2>
          <ul>
            <li>아이의 연령 또는 학년</li>
            <li>관심 있는 프로그램</li>
            <li>희망 요일 또는 시간대</li>
            <li>상담받고 싶은 내용</li>
          </ul>
          <aside class="callout">
            빠른 상담을 원하시면 온라인 상담신청 링크를 먼저 남겨 주세요. 확인 후 순차적으로 연락드립니다.
          </aside>
          <div class="cta">
            <h3>프로그램을 먼저 살펴보실래요?</h3>
            <p>수업 성격을 확인한 뒤 상담을 신청하시면 더 빠르게 안내받으실 수 있습니다.</p>
            <a href="/services" class="btn">Programs 보기</a>
          </div>
        </div>
      </section>
    </BaseLayout>
  )
}
