---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSitePageFull } from '../lib/notion';

const page = await getSitePageFull('contact');
const title = page?.meta.title || '문의';
const description = page?.meta.seoDescription || page?.meta.excerpt || '함께 일하고 싶거나 궁금한 점이 있다면 편하게 문의해 주세요.';
const body = page?.body || '';
const useNotion = Boolean(body);
---

{
  useNotion ? (
    <BaseLayout title={page!.meta.seoTitle || title} description={description}>
      <section class="post-detail">
        <span class="hero__pill">Contact</span>
        <h1 class="post-detail__title">{title}</h1>
        {page!.meta.excerpt && (
          <p class="post-detail__excerpt">{page!.meta.excerpt}</p>
        )}
        <div class="post-detail__body" set:html={body} />
        <div class="cta">
          <h3>보내기 전에 둘러보기</h3>
          <p>최근 글에서 우리가 다루는 주제를 먼저 확인하실 수 있습니다.</p>
          <a href="/blog" class="btn">블로그로 가기</a>
        </div>
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout title="문의" description="함께 일하고 싶거나 궁금한 점이 있다면 편하게 문의해 주세요.">
      <section class="post-detail">
        <span class="hero__pill">Contact</span>
        <h1 class="post-detail__title">문의하기</h1>
        <p class="post-detail__excerpt">
          협업 제안, 상담 요청, 단순한 질문까지 모두 환영합니다.
        </p>
        <div class="post-detail__body">
          <h2>가장 빠른 방법은 이메일</h2>
          <p>평일 기준 1~2일 안에 회신드립니다. 급한 일정은 제목에 [긴급] 표시를 부탁드립니다.</p>
          <h2>문의 시 포함하면 좋은 내용</h2>
          <ul>
            <li>현재 상황 / 배경</li>
            <li>원하시는 결과</li>
            <li>예상 일정 (있으면)</li>
            <li>예산 범위 (선택)</li>
          </ul>
          <aside class="callout">
            <strong>이메일:</strong> hello@example.com<br />
            <strong>응답 시간:</strong> 평일 1~2 영업일
          </aside>
          <div class="cta">
            <h3>보내기 전에 둘러보기</h3>
            <p>최근 글에서 우리가 다루는 주제를 먼저 확인하실 수 있습니다.</p>
            <a href="/blog" class="btn">블로그로 가기</a>
          </div>
        </div>
      </section>
    </BaseLayout>
  )
}
