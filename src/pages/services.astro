---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSitePageFull } from '../lib/notion';

const page = await getSitePageFull('services');
const title = page?.meta.title || '서비스';
const description = page?.meta.seoDescription || page?.meta.excerpt || '제공하는 서비스와 그 가치를 정리한 페이지입니다.';
const body = page?.body || '';
const useNotion = Boolean(body);
---

{
  useNotion ? (
    <BaseLayout title={page!.meta.seoTitle || title} description={description}>
      <section class="post-detail">
        <span class="hero__pill">Services</span>
        <h1 class="post-detail__title">{title}</h1>
        {page!.meta.excerpt && (
          <p class="post-detail__excerpt">{page!.meta.excerpt}</p>
        )}
        <div class="post-detail__body" set:html={body} />
        <div class="cta">
          <h3>어떤 서비스가 적합할지 같이 정해볼까요?</h3>
          <p>15분 정도면 방향이 잡힙니다.</p>
          <a href="/contact" class="btn">문의하기</a>
        </div>
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout
      title="서비스"
      description="제공하는 서비스와 그 가치를 정리한 페이지입니다."
    >
      <section class="post-detail">
        <span class="hero__pill">Services</span>
        <h1 class="post-detail__title">서비스 소개</h1>
        <p class="post-detail__excerpt">
          비즈니스에 실질적인 도움이 되는 핵심 서비스를 제공합니다.
        </p>
        <div class="post-detail__body">
          <h2>1. 노션 기반 홈페이지를 대신 만들어드립니다</h2>
          <p>
            Notion으로 콘텐츠를 관리하면서도, 화면은 노션처럼 보이지 않는 브랜드 사이트로 만들어 드립니다.
            도메인 연결, SEO 기본 설정, 디자인 커스터마이징까지 한 번에 처리합니다.
          </p>
          <h2>2. 검색에 잘 보이는 구조를 설계해드립니다</h2>
          <p>
            Google이 추천하는 사이트 구조(설명적 URL, 카테고리별 디렉터리, 메타데이터, canonical)를
            처음부터 깔끔하게 잡아 드립니다.
          </p>
          <h2>3. 네이버 블로그의 글을 새 사이트로 이전합니다</h2>
          <p>
            기존 네이버 블로그 콘텐츠를 새 사이트로 옮기면서, 중복 콘텐츠 문제 없이
            검색 트래픽이 새 도메인으로 자연스럽게 모이도록 도와드립니다.
          </p>
          <aside class="callout">비용이나 일정, 맞춤 상담이 필요하시면 언제든 문의해 주세요.</aside>
          <div class="cta">
            <h3>어떤 서비스가 적합할지 같이 정해볼까요?</h3>
            <p>15분 정도면 방향이 잡힙니다.</p>
            <a href="/contact" class="btn">문의하기</a>
          </div>
        </div>
      </section>
    </BaseLayout>
  )
}
