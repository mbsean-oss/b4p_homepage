---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSitePageFull } from '../lib/notion';

const page = await getSitePageFull('services');
const title = page?.meta.title || 'Programs';
const description = page?.meta.seoDescription || page?.meta.excerpt || '책먹는4차원화가의 수업 프로그램을 소개합니다.';
const body = page?.body || '';
const useNotion = Boolean(body);
---

{
  useNotion ? (
    <BaseLayout title={page!.meta.seoTitle || title} description={description}>
      <section class="post-detail">
        <span class="hero__pill">Programs</span>
        <h1 class="post-detail__title">{title}</h1>
        {page!.meta.excerpt && <p class="post-detail__excerpt">{page!.meta.excerpt}</p>}
        <div class="post-detail__body" set:html={body} />
        <div class="cta">
          <h3>어떤 프로그램이 맞을지 고민되시나요?</h3>
          <p>연령과 관심사에 맞춰 추천해 드립니다.</p>
          <a href="/contact" class="btn">문의하기</a>
        </div>
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout title="Programs" description="책먹는4차원화가의 수업 프로그램을 소개합니다.">
      <section class="post-detail">
        <span class="hero__pill">Programs</span>
        <h1 class="post-detail__title">수업 프로그램</h1>
        <p class="post-detail__excerpt">
          그림책 읽기, 작가 수업, 나만의 책 만들기까지 단계별 창작 경험을 제공합니다.
        </p>
        <div class="post-detail__body">
          <h2>동화책으로 상상</h2>
          <p>그림책을 읽고 장면을 해석하며 관찰력과 상상력을 확장하는 기초 프로그램입니다.</p>
          <h2>작가수업</h2>
          <p>주제를 깊이 있게 탐색하고 자신의 생각을 글과 그림으로 표현하는 창작 중심 수업입니다.</p>
          <h2>나만의책만들기</h2>
          <p>아이디어 구상부터 구성, 편집, 완성까지 한 권의 결과물로 이어지는 프로젝트형 프로그램입니다.</p>
          <h2>기초심화수업</h2>
          <p>연령과 숙련도에 따라 표현력과 완성도를 단계적으로 키우는 심화 수업입니다.</p>
          <h2>출판프로젝트</h2>
          <p>개인 또는 공동 작업 결과물을 실제 출판물 형태로 발전시키는 장기 프로젝트입니다.</p>
          <aside class="callout">세부 반 편성, 일정, 수강 가능 여부는 상담을 통해 안내해 드립니다.</aside>
          <div class="cta">
            <h3>어떤 프로그램이 맞을지 고민되시나요?</h3>
            <p>연령과 관심사에 맞춰 추천해 드립니다.</p>
            <a href="/contact" class="btn">문의하기</a>
          </div>
        </div>
      </section>
    </BaseLayout>
  )
}
