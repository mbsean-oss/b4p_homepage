---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSitePageFull } from '../lib/notion';

const page = await getSitePageFull('about');
const title = page?.meta.title || '학원 소개';
const description = page?.meta.seoDescription || page?.meta.excerpt || '책먹는4차원화가의 교육 철학과 공간을 소개합니다.';
const body = page?.body || '';
const useNotion = Boolean(page?.meta?.seoTitle || body);
---

{
  useNotion && body ? (
    <BaseLayout title={page!.meta.seoTitle || title} description={description}>
      <section class="post-detail">
        <span class="hero__pill" style="background:var(--color-accent-soft);">About</span>
        <h1 class="post-detail__title">{title}</h1>
        {page!.meta.excerpt && <p class="post-detail__excerpt">{page!.meta.excerpt}</p>}
        <div class="post-detail__body" set:html={body} />
        <div class="cta">
          <h3>수업 상담이 필요하신가요?</h3>
          <p>아이의 연령과 관심사에 맞는 프로그램을 함께 안내해 드립니다.</p>
          <a href="/contact" class="btn">문의 페이지로</a>
        </div>
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout title="학원 소개" description="책먹는4차원화가의 교육 철학과 공간을 소개합니다.">
      <section class="post-detail">
        <span class="hero__pill" style="background:var(--color-accent-soft);">About</span>
        <h1 class="post-detail__title">책먹는4차원화가를 소개합니다</h1>
        <p class="post-detail__excerpt">
          책과 그림, 대화와 표현이 자연스럽게 이어지는 수업으로 아이들의 상상력과 창작 자신감을 키웁니다.
        </p>
        <div class="post-detail__body">
          <p>
            책먹는4차원화가는 그림책 읽기에서 출발해 관찰, 표현, 스토리 구성, 나만의 결과물 만들기까지 이어지는 창작 중심 프로그램을 운영합니다.
            아이가 스스로 생각을 꺼내고 자신의 방식으로 표현하는 과정을 가장 중요하게 생각합니다.
          </p>
          <h2>교육 철학</h2>
          <p>
            정답을 빠르게 찾는 수업보다, 질문을 넓히고 시선을 확장하는 수업을 지향합니다.
            책 한 권을 읽더라도 감상에 머무르지 않고 그림, 글, 말, 만들기 활동으로 연결해 아이의 언어와 감각이 함께 자라도록 돕습니다.
          </p>
          <h2>운영 공간</h2>
          <p>
            광교본원과 망포분원에서 연령과 주제에 맞춘 프로그램을 운영하고 있으며, 출판 프로젝트와 작가 수업처럼 장기적인 창작 과정이 필요한 수업도 함께 진행합니다.
          </p>
          <aside class="callout">
            <strong>추천 대상</strong><br />
            그림책을 좋아하는 아이, 자신의 생각을 말과 그림으로 표현하고 싶은 아이,
            완성도 있는 개인 결과물을 만들어 보고 싶은 아이에게 특히 잘 맞습니다.
          </aside>
          <div class="cta">
            <h3>수업 상담이 필요하신가요?</h3>
            <p>아이의 연령과 관심사에 맞는 프로그램을 함께 안내해 드립니다.</p>
            <a href="/contact" class="btn">문의 페이지로</a>
          </div>
        </div>
      </section>
    </BaseLayout>
  )
}
