---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSitePageFull } from '../lib/notion';

const page = await getSitePageFull('about');
const title = page?.meta.title || '소개';
const description = page?.meta.seoDescription || page?.meta.excerpt || '홈페이지와 블로그를 운영하는 사람/브랜드를 소개합니다.';
const body = page?.body || '';
const useNotion = Boolean(page?.meta?.seoTitle || body);
---

{
  useNotion && body ? (
    <BaseLayout title={page!.meta.seoTitle || title} description={description}>
      <section class="post-detail">
        <span class="hero__pill" style="background:var(--color-accent-soft);">About</span>
        <h1 class="post-detail__title">{title}</h1>
        {page!.meta.excerpt && (
          <p class="post-detail__excerpt">{page!.meta.excerpt}</p>
        )}
        <div class="post-detail__body" set:html={body} />
        <div class="cta">
          <h3>함께 일하고 싶으신가요?</h3>
          <p>문의 페이지에서 편하게 연락 주세요.</p>
          <a href="/contact" class="btn">문의 페이지로</a>
        </div>
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout
      title="소개"
      description="홈페이지와 블로그를 운영하는 사람/브랜드를 소개합니다."
    >
      <section class="post-detail">
        <span class="hero__pill" style="background:var(--color-accent-soft);">About</span>
        <h1 class="post-detail__title">저희를 소개합니다</h1>
        <p class="post-detail__excerpt">
          노션으로 콘텐츠를 관리하고, Cloudflare Pages로 빠르게 전달하는 비즈니스 홈페이지를 만들고 있습니다.
        </p>
        <div class="post-detail__body">
          <p>
            이 사이트는 <strong>Notion을 CMS로 사용</strong>하고 <strong>Astro + Cloudflare Pages</strong>로 배포되는 구조입니다.
            운영자는 노션에서 글만 작성하면 자동으로 웹사이트에 반영됩니다.
          </p>
          <h2>왜 이런 구조를 선택했나</h2>
          <p>
            읽기 전용 비즈니스 사이트에서는 정적 생성이 가장 빠르고 SEO에 유리합니다.
            Google은 사전 렌더링을 검색엔진 친화적이라고 안내하고 있고,
            Cloudflare의 글로벌 엣지 네트워크는 어디서 접속해도 빠른 응답을 보장합니다.
          </p>
          <aside class="callout">
            <strong>핵심 원칙</strong><br />- 콘텐츠는 Notion에서 관리<br />- 화면은 브랜드 사이트처럼 자유롭게 디자인<br />- SEO는 정적 HTML과 메타로 충분히 챙김
          </aside>
          <h2>운영 방식</h2>
          <p>
            새 글을 쓰거나 기존 글을 수정할 때는 Notion 데이터베이스에서 발행 상태와 메타 정보만 갱신하면 됩니다.
            GitHub 자동 빌드를 통해 정적 사이트가 재생성되고, Cloudflare Pages가 즉시 배포합니다.
          </p>
          <div class="cta">
            <h3>함께 일하고 싶으신가요?</h3>
            <p>문의 페이지에서 편하게 연락 주세요.</p>
            <a href="/contact" class="btn">문의 페이지로</a>
          </div>
        </div>
      </section>
    </BaseLayout>
  )
}
