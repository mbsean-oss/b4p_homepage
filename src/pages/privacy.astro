---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSitePageFull } from '../lib/notion';
import { SITE_NAME } from '../lib/site';

const page = await getSitePageFull('privacy');
const title = page?.meta.title || '개인정보처리방침';
const description = page?.meta.seoDescription || `${SITE_NAME}의 개인정보처리방침입니다.`;
const body = page?.body || '';
const useNotion = Boolean(body);
---

{
  useNotion ? (
    <BaseLayout title={page!.meta.seoTitle || title} description={description}>
      <section class="post-detail">
        <h1 class="post-detail__title">{title}</h1>
        {page!.meta.excerpt && <p class="post-detail__excerpt">{page!.meta.excerpt}</p>}
        <div class="post-detail__body" set:html={body} />
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout title="개인정보처리방침" description={`${SITE_NAME}의 개인정보처리방침입니다.`}>
      <section class="post-detail">
        <h1 class="post-detail__title">개인정보처리방침</h1>
        <p class="post-detail__excerpt">
          책먹는4차원화가는 상담 및 문의 과정에서 제공받은 개인정보를 관련 법령에 따라 안전하게 관리합니다.
        </p>
        <div class="post-detail__body">
          <h2>수집 항목</h2>
          <p>이름, 연락처, 이메일 주소, 상담 내용 등 이용자가 자발적으로 남긴 정보에 한해 수집합니다.</p>
          <h2>이용 목적</h2>
          <p>수업 상담, 문의 응대, 일정 안내, 서비스 제공을 위한 연락 목적으로만 사용합니다.</p>
          <h2>보관 기간</h2>
          <p>상담 종료 후 관련 법령 또는 내부 운영 기준에 따라 필요한 기간 동안만 보관한 뒤 안전하게 파기합니다.</p>
          <h2>제3자 제공</h2>
          <p>법령에 근거한 경우를 제외하고, 이용자의 동의 없이 개인정보를 외부에 제공하지 않습니다.</p>
          <h2>문의</h2>
          <p>개인정보 관련 문의는 <a href="mailto:book4painter@naver.com">book4painter@naver.com</a>으로 연락해 주세요.</p>
        </div>
      </section>
    </BaseLayout>
  )
}
