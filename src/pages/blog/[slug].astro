---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, getBlogPostBySlug } from '../../lib/notion';
import { format } from 'date-fns';
import type { BlogPost } from '../../lib/notion';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: BlogPost };
const full = await getBlogPostBySlug(post.slug);
const body = full?.body || '';
const useNotion = Boolean(body);

const formattedDate = post.publishedAt
  ? format(new Date(post.publishedAt), 'yyyy.MM.dd')
  : '';
---

<BaseLayout
  title={post.seoTitle || post.title}
  description={post.seoDescription || post.excerpt}
>
  <article class="post-detail">
    <header class="post-detail__header">
      {post.category && (
        <span class="hero__pill">{post.category}</span>
      )}
      <h1 class="post-detail__title">{post.title}</h1>
      {post.excerpt && (
        <p class="post-detail__excerpt">{post.excerpt}</p>
      )}
      <div class="post-detail__meta">
        {formattedDate && (
          <time datetime={post.publishedAt}>{formattedDate}</time>
        )}
        {post.tags && post.tags.length > 0 && (
          <div class="post-detail__tags">
            {post.tags.map((tag) => (
              <span class="blog-list__chip">#{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    {useNotion ? (
      <div class="post-detail__body" set:html={body} />
    ) : (
      <div class="post-detail__body">
        <p>이 글은 곧 더 풍부한 내용으로 업데이트될 예정입니다.</p>
        <aside class="callout">
          운영 중인 사이트에서는 노션에서 본문을 직접 관리하는 것을 권장드립니다.
          <br />- Posts 데이터베이스의 published 체크
          <br />- 본문 블록은 노션 페이지 본문 영역에 작성
        </aside>
        <h2>관련 후속 행동</h2>
        <ul>
          <li>현재 글의 카테고리와 슬러그가 일관되는지 확인합니다.</li>
          <li>SEO 메타(title, description) 값을 채워 발행 품질을 높입니다.</li>
          <li>필요시 네이버 블로그에서 가져온 글로 표시하려면 legacy_url 을 채워주세요.</li>
        </ul>
      </div>
    )}

    {post.legacyUrl && (
      <p class="post-detail__legacy">
        이 글은 이전 <a href={post.legacyUrl} rel="canonical">네이버 블로그 포스트</a>에서 가져온 글입니다.
      </p>
    )}
  </article>
</BaseLayout>
