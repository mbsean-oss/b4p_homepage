---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_DESCRIPTION, getAllPosts } from '../lib/site';
import {
  getHomeNotices,
  getHomePrograms,
  getHomeSketches,
  getSitePageFull,
} from '../lib/notion';

const posts = await getAllPosts();
const recentPosts = posts.slice(0, 3);
const notices = await getHomeNotices(5);
const programs = await getHomePrograms(5);
const sketches = await getHomeSketches(3);

const homePage = await getSitePageFull('home');
const heroTitle = homePage?.meta.title || SITE_NAME;
const heroSubtitle = homePage?.meta.excerpt || SITE_DESCRIPTION;
const sliderImages = homePage?.meta.heroSliderImages?.slice(0, 5) || [];
const hasSlider = sliderImages.length > 0;
const sliderEnabled = Boolean(homePage?.meta.heroSliderEnabled && sliderImages.length > 1);
const sliderAutoplaySec = Math.max(2, homePage?.meta.heroSliderAutoplaySec || 4);
const featureImage = homePage?.meta.heroFeatureImage || '';
const featureCaption = homePage?.meta.heroFeatureCaption || '';
const featureBgMode = homePage?.meta.heroFeatureBgMode || 'auto';
const heroPrimaryLabel = homePage?.meta.heroPrimaryLabel || '수업 프로그램 보기';
const heroPrimaryUrl = homePage?.meta.heroPrimaryUrl || '/services';
const secondaryImage = homePage?.meta.heroSecondaryImage || '';
const heroSecondaryText = homePage?.meta.heroSecondaryText || '모집 일정과 특강 소식을 한눈에 확인해보세요';
const heroSecondaryLabel = homePage?.meta.heroSecondaryLabel || '문의하기';
const heroSecondaryUrl = homePage?.meta.heroSecondaryUrl || '/contact';

const featureBgMap: Record<string, string> = {
  auto: '#eaf4f2',
  teal: '#d9ece9',
  cream: '#f6f1ea',
  'soft-orange': '#f9e9dd',
};

const featureFallbackBg = featureBgMap[featureBgMode] || featureBgMap.auto;

const programColorMap: Record<string, string> = {
  teal: '#6bb8c4',
  orange: '#f3b246',
  coral: '#de6651',
  yellow: '#f0c95c',
  neutral: '#1d222b',
};
---

<BaseLayout
  title={homePage?.meta.seoTitle || heroTitle}
  description={homePage?.meta.seoDescription || heroSubtitle}
>
  {
    !hasSlider && (
      <section class="home-intro home-intro--spacious">
        <div class="container home-intro__inner">
          <div>
            <h1 class="home-intro__title">{heroTitle}</h1>
            {heroSubtitle && <p class="home-intro__subtitle">{heroSubtitle}</p>}
          </div>
        </div>
      </section>
    )
  }

  {
    hasSlider && (
      <section class="home-slider-section">
        <div
          class="home-slider"
          data-home-carousel
          data-autoplay-seconds={String(sliderAutoplaySec)}
          data-enabled={sliderEnabled ? 'true' : 'false'}
        >
          <div class="home-slider__viewport" data-carousel-viewport>
            {sliderImages.map((image, index) => (
              <figure class={`home-slider__slide${index === 0 ? ' is-active' : ''}`} data-slide>
                <img src={image} alt={`홈 메인 이미지 ${index + 1}`} loading={index === 0 ? 'eager' : 'lazy'} data-slide-image />
              </figure>
            ))}
          </div>

          {sliderImages.length > 1 && (
            <>
              <button type="button" class="home-slider__nav home-slider__nav--prev" aria-label="이전 이미지" data-carousel-prev>
                &lt;
              </button>
              <button type="button" class="home-slider__nav home-slider__nav--next" aria-label="다음 이미지" data-carousel-next>
                &gt;
              </button>
              <div class="home-slider__dots" aria-hidden="true">
                {sliderImages.map((_, index) => (
                  <button type="button" class={`home-slider__dot${index === 0 ? ' is-active' : ''}`} data-dot></button>
                ))}
              </div>
            </>
          )}
        </div>
      </section>
    )
  }

  {
    featureImage && (
      <section class="feature-band" style={`--feature-fallback-bg:${featureFallbackBg};`} data-feature-band>
        <div class="feature-band__backdrop" style={`background-image:url('${featureImage}')`}></div>
        <div class="container feature-band__container">
          <div class="feature-band__frame" data-feature-frame>
            <img src={featureImage} alt={featureCaption || '학원 대표 이미지'} loading="lazy" data-feature-image />
            <div class="feature-band__overlay">
              {featureCaption && <p class="feature-band__caption">{featureCaption}</p>}
              <a href={heroPrimaryUrl} class="btn btn--primary feature-band__cta">{heroPrimaryLabel}</a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    programs.length > 0 && (
      <section class="section section--programs">
        <div class="container">
          <div class="section-heading">
            <h2 class="section__title">수업 프로그램</h2>
            <p class="section__subtitle">책과 그림, 이야기로 연결되는 다섯 가지 프로그램을 소개합니다.</p>
          </div>

          <div class="program-carousel" data-program-carousel>
            <div class="program-carousel__viewport">
              <div class="program-carousel__track" data-program-track>
                {programs.map((program) => (
                  <article class="program-card" style={`--program-accent:${programColorMap[program.accentColor] || programColorMap.neutral};`} data-program-slide>
                    <div class="program-card__icon-wrap">
                      {program.iconImage ? (
                        <img src={program.iconImage} alt={program.title} class="program-card__icon" loading="lazy" />
                      ) : (
                        <div class="program-card__icon program-card__icon--placeholder">{program.title.slice(0, 1)}</div>
                      )}
                    </div>
                    <h3 class="program-card__title">{program.title}</h3>
                    {program.summary && <p class="program-card__summary">{program.summary}</p>}
                  </article>
                ))}
              </div>
            </div>
            {programs.length > 1 && (
              <div class="program-carousel__dots" aria-hidden="true">
                {programs.map((_, index) => (
                  <button type="button" class={`program-carousel__dot${index === 0 ? ' is-active' : ''}`} data-program-dot></button>
                ))}
              </div>
            )}
          </div>

          <div class="section-cta section-cta--left">
            <a href="/services" class="btn btn--ghost">프로그램 자세히 보기</a>
          </div>
        </div>
      </section>
    )
  }

  <section class="section notice-promo-section">
    <div class="container notice-promo-grid">
      <div class="notice-panel notice-panel--plain">
        <div class="section-heading">
          <h2 class="section__title">학원 공지사항</h2>
          <p class="section__subtitle">운영 공지, 모집 일정, 특강 소식을 빠르게 확인하세요.</p>
        </div>

        {notices.length > 0 ? (
          <ul class="notice-list">
            {notices.map((notice) => (
              <li class="notice-item notice-item--plain">
                <div class="notice-item__meta">
                  {notice.important && <span class="notice-badge notice-badge--important">중요</span>}
                  {notice.location && <span class="notice-badge">{notice.location}</span>}
                  {notice.category && <span class="notice-badge">{notice.category}</span>}
                </div>
                <div class="notice-item__body">
                  {notice.slug ? (
                    <a href={`/notices/${notice.slug}`} class="notice-item__title">{notice.title}</a>
                  ) : notice.linkUrl ? (
                    <a href={notice.linkUrl} class="notice-item__title" target="_blank" rel="noreferrer">{notice.title}</a>
                  ) : (
                    <span class="notice-item__title">{notice.title}</span>
                  )}
                  <time class="notice-item__date" datetime={notice.publishedAt}>{notice.publishedAt}</time>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <div class="notice-empty">공지사항이 준비되면 이 영역에 자동으로 노출됩니다.</div>
        )}

        <div class="section-cta section-cta--left">
          <a href="/notices" class="btn btn--ghost">공지사항 더보기</a>
        </div>
      </div>

      {
        secondaryImage && (
          <aside class="promo-card">
            <div class="promo-card__media">
              <img src={secondaryImage} alt={heroSecondaryText || '안내 이미지'} loading="lazy" />
              <div class="promo-card__content promo-card__content--overlay">
                {heroSecondaryText && <p class="promo-card__text">{heroSecondaryText}</p>}
                <a href={heroSecondaryUrl} class="btn btn--primary promo-card__cta">{heroSecondaryLabel}</a>
              </div>
            </div>
          </aside>
        )
      }
    </div>
  </section>

  <section class="section section--muted">
    <div class="container story-grid">
      <div>
        <div class="section-heading">
          <h2 class="section__title">블로그 최신글</h2>
          <p class="section__subtitle">최근 올라온 글을 간결하게 모아보았습니다.</p>
        </div>
        <div class="blog-card-list">
          {recentPosts.map((post) => (
            <a href={`/blog/${post.slug}`} class="blog-mini-card">
              <div class="blog-mini-card__thumb-wrap">
                {post.coverImage ? (
                  <img src={post.coverImage} alt={post.title} class="blog-mini-card__thumb" loading="lazy" />
                ) : (
                  <div class="blog-mini-card__thumb blog-mini-card__thumb--empty"></div>
                )}
              </div>
              <div class="blog-mini-card__body">
                <span class="blog-mini-card__category">{post.category || '블로그'}</span>
                <strong class="blog-mini-card__title">{post.title}</strong>
                {post.excerpt && <span class="blog-mini-card__excerpt">{post.excerpt}</span>}
                <span class="blog-mini-card__date">{post.publishedAt}</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div>
        <div class="section-heading">
          <h2 class="section__title">수업스케치</h2>
          <p class="section__subtitle">수업 장면과 결과물을 심플하게 기록하는 공간입니다.</p>
        </div>
        <div class="sketch-grid">
          {sketches.map((sketch, index) => (
            <button type="button" class="sketch-card" data-lightbox-trigger data-lightbox-image={sketch.image} data-lightbox-alt={sketch.title} aria-label={`${sketch.title} 확대 보기`}>
              <img src={sketch.image} alt={sketch.title} class="sketch-card__image" loading="lazy" />
            </button>
          ))}
        </div>
        <div class="section-cta section-cta--left">
          <a href="/sketches" class="btn btn--ghost">수업스케치 더보기</a>
        </div>
      </div>
    </div>
  </section>

  <dialog class="lightbox" data-lightbox>
    <button type="button" class="lightbox__close" aria-label="닫기" data-lightbox-close>×</button>
    <img src="" alt="" class="lightbox__image" data-lightbox-view />
  </dialog>

  <script>
    const setupHomeCarousel = () => {
      const root = document.querySelector('[data-home-carousel]');
      if (!root) return;

      const slides = Array.from(root.querySelectorAll('[data-slide]'));
      const images = Array.from(root.querySelectorAll('[data-slide-image]'));
      const dots = Array.from(root.querySelectorAll('[data-dot]'));
      const viewport = root.querySelector('[data-carousel-viewport]');
      const prevBtn = root.querySelector('[data-carousel-prev]');
      const nextBtn = root.querySelector('[data-carousel-next]');
      const autoplaySeconds = Number(root.getAttribute('data-autoplay-seconds') || '4');
      const isEnabled = root.getAttribute('data-enabled') === 'true';
      let current = 0;
      let timer = null;
      let touchStartX = 0;
      let touchDeltaX = 0;

      const restart = () => {
        if (timer) window.clearInterval(timer);
        if (slides.length > 1 && isEnabled) {
          timer = window.setInterval(() => show((current + 1) % slides.length), Math.max(2, autoplaySeconds) * 1000);
        }
      };

      const setViewportHeight = (index) => {
        if (!viewport || !images[index]) return;
        const img = images[index];
        const apply = () => {
          if (!img.naturalWidth || !img.naturalHeight) return;
          const ratio = img.naturalHeight / img.naturalWidth;
          const width = viewport.clientWidth || img.clientWidth;
          const maxHeight = window.innerWidth < 768 ? window.innerHeight * 0.52 : window.innerHeight * 0.72;
          const height = Math.max(280, Math.min(maxHeight, width * ratio));
          viewport.style.height = `${height}px`;
        };
        if (img.complete) apply();
        else img.addEventListener('load', apply, { once: true });
      };

      const show = (index) => {
        current = index;
        slides.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
        setViewportHeight(index);
      };

      images.forEach((img, index) => {
        if (img.complete) setViewportHeight(index);
        else img.addEventListener('load', () => current === index && setViewportHeight(index), { once: true });
      });

      prevBtn?.addEventListener('click', () => {
        show((current - 1 + slides.length) % slides.length);
        restart();
      });

      nextBtn?.addEventListener('click', () => {
        show((current + 1) % slides.length);
        restart();
      });

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          show(index);
          restart();
        });
      });

      viewport?.addEventListener('touchstart', (event) => {
        touchStartX = event.changedTouches[0].clientX;
        touchDeltaX = 0;
      }, { passive: true });

      viewport?.addEventListener('touchmove', (event) => {
        touchDeltaX = event.changedTouches[0].clientX - touchStartX;
      }, { passive: true });

      viewport?.addEventListener('touchend', () => {
        if (Math.abs(touchDeltaX) > 40) {
          if (touchDeltaX < 0) show((current + 1) % slides.length);
          else show((current - 1 + slides.length) % slides.length);
          restart();
        }
      });

      root.addEventListener('mouseenter', () => timer && window.clearInterval(timer));
      root.addEventListener('mouseleave', restart);
      window.addEventListener('resize', () => show(current));

      show(0);
      restart();
    };

    const setupFeatureTint = () => {
      const band = document.querySelector('[data-feature-band]');
      const frame = document.querySelector('[data-feature-frame]');
      const img = document.querySelector('[data-feature-image]');
      if (!band || !frame || !img) return;

      const applyTint = () => {
        try {
          const canvas = document.createElement('canvas');
          const ctx = canvas.getContext('2d');
          if (!ctx || !img.naturalWidth || !img.naturalHeight) return;
          const sampleSize = 32;
          canvas.width = sampleSize;
          canvas.height = sampleSize;
          ctx.drawImage(img, 0, 0, sampleSize, sampleSize);
          const { data } = ctx.getImageData(0, 0, sampleSize, sampleSize);
          let r = 0;
          let g = 0;
          let b = 0;
          let count = 0;
          for (let i = 0; i < data.length; i += 16) {
            r += data[i];
            g += data[i + 1];
            b += data[i + 2];
            count += 1;
          }
          if (!count) return;
          band.style.setProperty('--feature-rgb', `${Math.round(r / count)}, ${Math.round(g / count)}, ${Math.round(b / count)}`);
        } catch (error) {
          frame.classList.add('is-tint-fallback');
        }
      };

      if (img.complete) applyTint();
      else img.addEventListener('load', applyTint, { once: true });
    };

    const setupProgramCarousel = () => {
      const root = document.querySelector('[data-program-carousel]');
      if (!root) return;
      const track = root.querySelector('[data-program-track]');
      const viewport = root.querySelector('.program-carousel__viewport');
      const slides = Array.from(root.querySelectorAll('[data-program-slide]'));
      const dots = Array.from(root.querySelectorAll('[data-program-dot]'));
      if (!track || !viewport || slides.length === 0) return;

      const mobileQuery = window.matchMedia('(max-width: 760px)');
      let current = 0;
      let timer = null;
      let touchStartX = 0;
      let touchDeltaX = 0;

      const restart = () => {
        if (timer) window.clearInterval(timer);
        if (mobileQuery.matches && slides.length > 1) {
          timer = window.setInterval(() => show((current + 1) % slides.length), 3600);
        }
      };

      const updateDots = () => {
        dots.forEach((dot, index) => dot.classList.toggle('is-active', index === current));
      };

      const show = (index) => {
        current = index;
        updateDots();
        if (!mobileQuery.matches) {
          track.style.transform = '';
          return;
        }
        const slide = slides[index];
        const offset = slide.offsetLeft - Math.max(0, (viewport.clientWidth - slide.clientWidth) / 2);
        track.style.transform = `translate3d(${-offset}px, 0, 0)`;
      };

      const handleMode = () => {
        if (!mobileQuery.matches) {
          track.style.transform = '';
          updateDots();
          if (timer) window.clearInterval(timer);
          return;
        }
        show(current);
        restart();
      };

      viewport.addEventListener('touchstart', (event) => {
        if (!mobileQuery.matches) return;
        touchStartX = event.changedTouches[0].clientX;
        touchDeltaX = 0;
      }, { passive: true });

      viewport.addEventListener('touchmove', (event) => {
        if (!mobileQuery.matches) return;
        touchDeltaX = event.changedTouches[0].clientX - touchStartX;
      }, { passive: true });

      viewport.addEventListener('touchend', () => {
        if (!mobileQuery.matches) return;
        if (Math.abs(touchDeltaX) > 36) {
          if (touchDeltaX < 0) show((current + 1) % slides.length);
          else show((current - 1 + slides.length) % slides.length);
          restart();
        }
      });

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          show(index);
          restart();
        });
      });

      root.addEventListener('mouseenter', () => timer && window.clearInterval(timer));
      root.addEventListener('mouseleave', restart);
      mobileQuery.addEventListener('change', handleMode);
      window.addEventListener('resize', handleMode);
      handleMode();
    };

    const setupLightbox = () => {
      const dialog = document.querySelector('[data-lightbox]');
      const view = dialog?.querySelector('[data-lightbox-view]');
      const closeBtn = dialog?.querySelector('[data-lightbox-close]');
      if (!dialog || !view) return;

      const open = (src, alt) => {
        view.setAttribute('src', src || '');
        view.setAttribute('alt', alt || '확대 이미지');
        dialog.showModal();
        document.documentElement.classList.add('is-lightbox-open');
      };

      const close = () => {
        dialog.close();
        document.documentElement.classList.remove('is-lightbox-open');
      };

      document.querySelectorAll('[data-lightbox-trigger]').forEach((trigger) => {
        trigger.addEventListener('click', () => open(trigger.getAttribute('data-lightbox-image'), trigger.getAttribute('data-lightbox-alt')));
      });

      closeBtn?.addEventListener('click', close);
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) close();
      });
      dialog.addEventListener('close', () => document.documentElement.classList.remove('is-lightbox-open'));
    };

    setupHomeCarousel();
    setupFeatureTint();
    setupProgramCarousel();
    setupLightbox();
  </script>
</BaseLayout>

<style>
  .home-intro {
    background: #fff;
  }

  .home-intro--spacious {
    padding: 5.5rem 0 5rem;
  }

  .home-intro__inner {
    display: flex;
    justify-content: center;
    text-align: center;
  }

  .home-intro__title {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 800;
    color: #153934;
  }

  .home-intro__subtitle {
    margin: 0.9rem auto 0;
    max-width: 760px;
    color: #5f676f;
    font-size: 1rem;
  }

  .home-slider-section {
    background: #fff;
    padding: 0 0 2rem;
  }

  .home-slider {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 1.25rem;
    position: relative;
  }

  .home-slider__viewport {
    position: relative;
    width: 100%;
    min-height: 320px;
    overflow: hidden;
    background: #fff;
    touch-action: pan-y;
  }

  .home-slider__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .home-slider__slide.is-active {
    opacity: 1;
  }

  .home-slider__slide img {
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  .home-slider__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 46px;
    height: 46px;
    border-radius: 999px;
    border: 1px solid rgba(21, 57, 52, 0.14);
    background: rgba(255, 255, 255, 0.88);
    color: #173934;
    font-size: 1.2rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
  }

  .home-slider__nav--prev { left: 2rem; }
  .home-slider__nav--next { right: 2rem; }

  .home-slider__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.95rem;
  }

  .home-slider__dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: #d6dce2;
    border: none;
    padding: 0;
    transition: transform 0.2s ease, background 0.2s ease;
    cursor: pointer;
  }

  .home-slider__dot.is-active {
    background: #6bb8c4;
    transform: scale(1.2);
  }

  .feature-band {
    --feature-rgb: 107, 184, 196;
    background: radial-gradient(circle at center, rgba(var(--feature-rgb), 0.13), transparent 62%), var(--feature-fallback-bg);
    position: relative;
    overflow: hidden;
    padding: 4rem 0;
  }

  .feature-band__backdrop {
    position: absolute;
    inset: 0;
    background-position: center;
    background-size: cover;
    filter: blur(50px) saturate(118%);
    opacity: 0.34;
    transform: scale(1.12);
  }

  .feature-band__container {
    position: relative;
    z-index: 1;
  }

  .feature-band__frame {
    position: relative;
    overflow: visible;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .feature-band__frame img {
    width: 100%;
    height: auto;
    display: block;
  }

  .feature-band__overlay {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.8rem;
    max-width: min(340px, calc(100% - 3rem));
  }

  .feature-band__caption {
    margin: 0;
    background: none;
    backdrop-filter: none;
    color: #fff;
    padding: 0;
    border-radius: 0;
    font-weight: 700;
    text-align: right;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
    box-shadow: none;
  }

  .feature-band .btn--primary,
  .promo-card .btn--primary {
    background: #12779a;
    border-color: #12779a;
    color: #fff;
