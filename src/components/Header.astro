---
import { SITE_NAME, getNavItems } from '../lib/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const navItems = await getNavItems();
---
<header class="site-header site-header--brand" data-mobile-nav-root>
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo site-header__logo--image" aria-label={`${SITE_NAME} 홈`}>
      <img src="/logo-book4painter-header.png" alt="책먹는4차원화가" class="site-header__brand-image" />
    </a>

    <button type="button" class="site-header__menu-toggle" aria-label="메뉴 열기" aria-expanded="false" data-mobile-nav-toggle>
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="site-nav" aria-label="주요 메뉴" data-mobile-nav-panel>
      {
        navItems.map((item) => {
          const itemPath = item.href.replace(/\/$/, '') || '/';
          const isActive = currentPath === itemPath || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a href={item.href} class={isActive ? 'is-active' : ''}>
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<script>
  const setupMobileNav = () => {
    const root = document.querySelector('[data-mobile-nav-root]');
    if (!root) return;
    const toggle = root.querySelector('[data-mobile-nav-toggle]');
    const panel = root.querySelector('[data-mobile-nav-panel]');
    if (!toggle || !panel) return;

    const close = () => {
      root.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
    };

    toggle.addEventListener('click', () => {
      const willOpen = !root.classList.contains('is-open');
      root.classList.toggle('is-open', willOpen);
      toggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
    });

    panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    window.addEventListener('resize', () => {
      if (window.innerWidth > 900) close();
    });
  };

  setupMobileNav();
</script>

<style>
  .site-header--brand {
    background: rgba(255, 255, 255, 0.97);
  }

  .site-header__logo--image {
    display: inline-flex;
    align-items: center;
    max-width: min(100%, 360px);
  }

  .site-header__logo--image:hover {
    text-decoration: none;
  }

  .site-header__brand-image {
    display: block;
    width: min(100%, 340px);
    height: auto;
  }

  .site-header__menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid rgba(21, 57, 52, 0.12);
    background: #fff;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 4px;
    cursor: pointer;
    padding: 0;
  }

  .site-header__menu-toggle span {
    width: 18px;
    height: 2px;
    background: #173934;
    border-radius: 999px;
    display: block;
  }

  .site-nav a.is-active,
  .site-nav a:hover {
    color: #EB6441;
  }

  @media (max-width: 900px) {
    .site-header__inner {
      position: relative;
      height: 72px;
    }

    .site-header__brand-image {
      width: min(100%, 230px);
    }

    .site-header__menu-toggle {
      display: inline-flex;
    }

    .site-nav {
      position: absolute;
      top: calc(100% + 10px);
      right: 18px;
      left: 18px;
      display: none;
      flex-direction: column;
      gap: 0;
      padding: 0.65rem;
      background: rgba(255, 255, 255, 0.98);
      border: 1px solid rgba(15, 23, 42, 0.08);
      border-radius: 18px;
      box-shadow: 0 18px 42px rgba(15, 23, 42, 0.12);
      z-index: 60;
    }

    .site-nav a {
      padding: 0.9rem 0.95rem;
      border-radius: 12px;
      color: #173934;
    }

    .site-nav a.is-active,
    .site-nav a:hover {
      background: rgba(235, 100, 65, 0.08);
      color: #EB6441;
    }

    .site-header.is-open .site-nav {
      display: flex;
    }
  }
</style>
