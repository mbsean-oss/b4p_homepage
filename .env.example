# Notion API Integration (optional - site works in mock mode without these)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_PAGES_DB_ID=your_pages_database_id_here
NOTION_POSTS_DB_ID=your_posts_database_id_here

# Public site URL (used for canonical URLs, sitemap, RSS)
SITE_URL=https://example.com
SITE_NAME=My Business Site
SITE_DESCRIPTION=A clean business homepage powered by Notion + Astro + Cloudflare Pages
